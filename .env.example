# STRATAPROOF MVP 0.1 Environment Configuration
APP_NAME="STRATAPROOF"
APP_ENV="development"
APP_SECRET_KEY="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_STRING"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional Next.js API URL override (defaults to same-origin /api/v1)
NEXT_PUBLIC_API_URL="/api/v1"

# Pluggable LLM Provider ("disabled" | "openai" | "anthropic" | "gemini")
AI_PROVIDER="disabled"
AI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1500
